<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- FieldKit.* packages come from GitHub Packages; everything else from nuget.org.
       GitHub Packages needs a sign-in even to download: add your read:packages token once in your
       user-level NuGet config under the source name "fieldkit" (see README, "Building"). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="fieldkit" value="https://nuget.pkg.github.com/NelsonLamprecht/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="fieldkit">
      <package pattern="FieldKit.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
