<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:Halloween.Director.Remote.ViewModel"
    xmlns:views="clr-namespace:Halloween.Director.Remote.Views"
    x:DataType="viewmodel:MonsterBoxControllerViewModel"
    x:Class="Halloween.Director.Remote.Views.MonsterBoxControllerPage"
    BackgroundColor="{AppThemeBinding Light={StaticResource SpookyGreenLight}, Dark={StaticResource SpookyGreenDark}}"
    Title="Halloween Director">

    <ContentPage.Content>
        <Grid>
            <Grid
                BackgroundColor="#88000000"
                IsVisible="{Binding IsBusy}"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Please Wait..." TextColor="White" HorizontalOptions="Center" />
                    <ActivityIndicator Color="White" IsRunning="True"  />
                </StackLayout>
            </Grid>

            <Grid
                x:Name="DeviceGrid"
                RowSpacing="10"
                Padding="10">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>
                <!-- One screen for both props: the MonsterBox panel (the sound buttons, which scroll if there
                     are many) takes all the height that is left, and the Scarecrow panel is a slim
                     Up/Down bar that is always visible at the bottom. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!--Top panel: MonsterBox sound/shake controls-->
                <Border
                    x:Name="MonsterBoxPanel"
                    Grid.Row="0"
                    VerticalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SpookyOrangeLight}, Dark={StaticResource SpookyOrangeDark}}" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="10">
                        <!-- Scrolls, because the number of sounds comes from the monsterbox and can be more than fit on the panel. -->
                        <ScrollView>
                            <VerticalStackLayout Spacing="6">
                                <Button
                                    Text="Shake"
                                    Style="{StaticResource ShakeButtonStyle}"
                                    HorizontalOptions="Fill"
                                    Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Shake}">
                                </Button>
                                <Border IsVisible="{Binding HasSoundsError}" BackgroundColor="#B00020" Stroke="Transparent" StrokeShape="RoundRectangle 5" Padding="10">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding SoundsError}" TextColor="White" />
                                        <Button Text="Retry" Command="{Binding RetrySoundsCommand}" HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                </Border>
                                <Label
                                    Text="FX"
                                    Style="{StaticResource SectionHeaderStyle}" />
                                <!-- Built from the monsterbox's GET /sounds (see MonsterBoxControllerViewModel.ApplySounds) -->
                                <views:SoundGrid
                                    Sounds="{Binding FxSounds}"
                                    ButtonStyle="{StaticResource FxButtonStyle}"
                                    ColumnSpacing="6"
                                    RowSpacing="6" />
                                <Label
                                    Text="CREATURES"
                                    Style="{StaticResource SectionHeaderStyle}" />
                                <views:SoundGrid
                                    Sounds="{Binding CreatureSounds}"
                                    ButtonStyle="{StaticResource CreatureButtonStyle}"
                                    ColumnSpacing="6"
                                    RowSpacing="6" />
                            </VerticalStackLayout>
                        </ScrollView>
                </Border>
                <!--Bottom panel: Scarecrow up/down controls-->
                <Border
                    x:Name="ScarecrowPanel"
                    Grid.Row="1"
                    VerticalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SpookyOrangeLight}, Dark={StaticResource SpookyOrangeDark}}" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="10">
                        <Grid ColumnSpacing="6" ColumnDefinitions="*,*">
                            <Button
                                Grid.Column="0"
                                Text="&#9650; Up"
                                Style="{StaticResource ScarecrowButtonStyle}"
                                HorizontalOptions="Fill"
                                HeightRequest="76"
                                Command="{Binding SendScarecrowCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Up}">
                            </Button>
                            <Button
                                Grid.Column="1"
                                Text="&#9660; Down"
                                Style="{StaticResource ScarecrowButtonStyle}"
                                HorizontalOptions="Fill"
                                HeightRequest="76"
                                Command="{Binding SendScarecrowCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Down}">
                            </Button>
                        </Grid>
                </Border>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
