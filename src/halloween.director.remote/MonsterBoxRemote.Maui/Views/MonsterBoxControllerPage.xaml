<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MonsterBoxRemote.Maui.ViewModel"
    x:DataType="viewmodel:MonsterBoxControllerViewModel"
    x:Class="MonsterBoxRemote.Maui.Views.MonsterBoxControllerPage"
    BackgroundColor="{AppThemeBinding Light={StaticResource SpookyGreenLight}, Dark={StaticResource SpookyGreenDark}}"
    Title="MonsterBox Controller">

    <ContentPage.Content>
        <Grid>
            <Grid
                BackgroundColor="#88000000"
                IsVisible="{Binding IsBusy}"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Please Wait..." TextColor="White" HorizontalOptions="Center" />
                    <ActivityIndicator Color="White" IsRunning="True"  />
                </StackLayout>
            </Grid>

            <Grid
                x:Name="DeviceGrid"
                RowSpacing="10"
                Padding="10">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>
                <!-- Stacked: MonsterBox on the top half, Scarecrow on the bottom
                     half, each spanning the full width so the sound buttons
                     aren't squeezed into a narrow column. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--Top panel: MonsterBox sound/shake controls-->
                <Border
                    x:Name="MonsterBoxPanel"
                    Grid.Row="0"
                    VerticalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SpookyOrangeLight}, Dark={StaticResource SpookyOrangeDark}}" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="10">
                        <Grid RowSpacing="6" ColumnSpacing="6"
                              RowDefinitions="*,Auto,*,*,Auto,*"
                              ColumnDefinitions="*,*,*,*,*">
                            <Button
                                Grid.Row="0"
                                Grid.ColumnSpan="5"
                                Text="Shake"
                                Style="{StaticResource ShakeButtonStyle}"
                                HorizontalOptions="Fill"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Shake}">
                            </Button>
                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="5"
                                Text="FX"
                                Style="{StaticResource SectionHeaderStyle}" />
                            <Button
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="Werewolf"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Werewolf}">
                            </Button>
                            <Button
                                Grid.Column="1"
                                Grid.Row="2"
                                Text="Laugh"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Laugh}">
                            </Button>
                            <Button
                                Grid.Column="2"
                                Grid.Row="2"
                                Text="Chains"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Chains}">
                            </Button>
                            <Button
                                Grid.Column="3"
                                Grid.Row="2"
                                Text="Heart&#8203;beat"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Heartbeat}">
                            </Button>
                            <Button
                                Grid.Column="4"
                                Grid.Row="2"
                                Text="Dragon Growl"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.DragonGrowl}">
                            </Button>
                            <Button
                                Grid.Column="0"
                                Grid.Row="3"
                                Text="Door creek"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.DoorCreek}">
                            </Button>
                            <Button
                                Grid.Column="1"
                                Grid.Row="3"
                                Text="Metal Hit"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.MetalHit}">
                            </Button>
                            <Button
                                Grid.Column="2"
                                Grid.Row="3"
                                Text="Raven"
                                Style="{StaticResource FxButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Raven}">
                            </Button>
                            <Label
                                Grid.Row="4"
                                Grid.ColumnSpan="5"
                                Text="CREATURES"
                                Style="{StaticResource SectionHeaderStyle}" />
                            <Button
                                Grid.Column="0"
                                Grid.Row="5"
                                Text="Creature 1"
                                Style="{StaticResource CreatureButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Creature1}">
                            </Button>
                            <Button
                                Grid.Column="1"
                                Grid.Row="5"
                                Text="Creature 2"
                                Style="{StaticResource CreatureButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Creature2}">
                            </Button>
                            <Button
                                Grid.Column="2"
                                Grid.Row="5"
                                Text="Creature 3"
                                Style="{StaticResource CreatureButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Creature3}">
                            </Button>
                            <Button
                                Grid.Column="3"
                                Grid.Row="5"
                                Text="Creature 4"
                                Style="{StaticResource CreatureButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Creature4}">
                            </Button>
                            <Button
                                Grid.Column="4"
                                Grid.Row="5"
                                Text="Creature 5"
                                Style="{StaticResource CreatureButtonStyle}"
                                Command="{Binding SendMonsterBoxCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Creature5}">
                            </Button>
                        </Grid>
                </Border>
                <!--Bottom panel: Scarecrow up/down controls-->
                <Border
                    x:Name="ScarecrowPanel"
                    Grid.Row="1"
                    VerticalOptions="Fill"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SpookyOrangeLight}, Dark={StaticResource SpookyOrangeDark}}" Stroke="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="10">
                        <Grid RowSpacing="6"
                              RowDefinitions="*,*">
                            <Button
                                Grid.Row="0"
                                Text="&#9650; Up"
                                Style="{StaticResource ScarecrowButtonStyle}"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                Command="{Binding SendScarecrowCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Up}">
                            </Button>
                            <Button
                                Grid.Row="1"
                                Text="&#9660; Down"
                                Style="{StaticResource ScarecrowButtonStyle}"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                Command="{Binding SendScarecrowCommand}" CommandParameter="{x:Static viewmodel:MonsterBoxCommands.Down}">
                            </Button>
                        </Grid>
                </Border>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
