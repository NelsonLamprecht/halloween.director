<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FieldKit.Meadow</RootNamespace>
    <AssemblyName>FieldKit.Meadow</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- missing XML doc comments on public members aren't worth a warning each -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>FieldKit.Meadow</PackageId>
    <Title>FieldKit.Meadow</Title>
    <Authors>Nelson Lamprecht</Authors>
    <Copyright>Copyright (c) 2026 Nelson Lamprecht</Copyright>
    <Description>A starter kit for networked Meadow F7 Feather devices: a base app that owns the boot sequence (status LED, diagnostics, WiFi, watchdog, heartbeat, Maple web server with UDP discovery and GET /info), plus relay and on/off controllers.</Description>
    <PackageTags>meadow;wilderness-labs;f7;iot;maple;watchdog</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/NelsonLamprecht/halloween.director/tree/main/src/FieldKit.Meadow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NelsonLamprecht/halloween.director</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- the package has its own version, separate from the firmware's VersionPrefix. It stays a
         prerelease while it depends on prerelease Meadow packages (NuGet warns otherwise). -->
    <PackageVersion>0.1.0-beta</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meadow.F7" />
    <PackageReference Include="Meadow.Foundation" />
    <PackageReference Include="Meadow.Foundation.Web.Maple.Server" />
  </ItemGroup>
</Project>
