<Project>
  <!-- One version for every project in the solution (firmware, shared library, remote app).
       Change VersionPrefix by hand for a release; BuildNumber is stamped on every build (UTC yyMMddHH)
       so you can tell which build is running. Pass -p:BuildNumber=123 to override it (for example from CI). -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <BuildNumber Condition="'$(BuildNumber)' == ''">$([System.DateTime]::UtcNow.ToString('yyMMddHH'))</BuildNumber>

    <!-- what the firmware logs at boot (see Halloween.Director.Shared.BuildInfo) -->
    <InformationalVersion>$(VersionPrefix) (build $(BuildNumber))</InformationalVersion>

    <!-- the remote app: the version name, and Android's integer versionCode -->
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <ApplicationVersion>$(BuildNumber)</ApplicationVersion>
  </PropertyGroup>
</Project>
